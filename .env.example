# =============================================================================
# FitSci Evaluator — environment configuration
# =============================================================================
# Copy to .env and adjust for your setup:
#   cp .env.example .env
#
# Two deployment modes (FITSCI_DEPLOYMENT):
#   local — services on localhost (default; use with `docker compose up -d`)
#   vps   — point host vars at your remote server IP / hostname
#
# You can set a full DSN (POSTGRES_DSN, RABBITMQ_URL) OR build from components.
# Component vars are easier when switching between local Docker and VPS.
# =============================================================================

# --- Deployment mode ---
FITSCI_DEPLOYMENT=local

# --- PostgreSQL ---
# Option A: full async SQLAlchemy DSN (overrides component vars below)
# POSTGRES_DSN=postgresql+asyncpg://fitsci:fitsci@localhost:5432/fitsci
#
# Option B: components (used when POSTGRES_DSN is unset)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fitsci
POSTGRES_PASSWORD=fitsci
POSTGRES_DB=fitsci
# Host port published by docker compose (change if 5432 is taken)
POSTGRES_PORT_PUBLISH=5432

# VPS example (uncomment and set your server IP):
# FITSCI_DEPLOYMENT=vps
# POSTGRES_HOST=203.0.113.50
# POSTGRES_PORT=5432
# POSTGRES_USER=fitsci
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=fitsci

# --- RabbitMQ ---
# RABBITMQ_URL=amqp://fitsci:fitsci@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=fitsci
RABBITMQ_PASSWORD=fitsci
RABBITMQ_VHOST=/
RABBITMQ_PORT_PUBLISH=5672
RABBITMQ_MANAGEMENT_PORT_PUBLISH=15672

# VPS example:
# RABBITMQ_HOST=203.0.113.50

# --- Ollama / Vertex ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT_PUBLISH=11434

# VPS example:
# OLLAMA_BASE_URL=http://203.0.113.50:11434

# gemma4:e2b
# gemma4:e4b
# gemma4:12b-q4_k_m
# gemma4:26b-a4b-it-q4_k_m
GEMMA_MODEL_TAG=gemma4:12b-q4_k_m
VERTEX_PROJECT=
VERTEX_LOCATION=europe-west4
VERTEX_MODEL=gemma-4-12b

# --- API (docker compose --profile app) ---
API_PORT_PUBLISH=8000

# --- NCBI / PMC ---
NCBI_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO

# --- Rate limiting (Phase 2 API) ---
RATE_LIMIT_PER_MINUTE=30

# --- Integration tests (optional) ---
# Set to 1 to run Postgres integration tests against docker compose:
# FITSCI_INTEGRATION=1
